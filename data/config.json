{
  "version": "1.0",
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 1.0,
    "languages": [
      "zh"
    ]
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "email_address": "513601594@qq.com",
    "password_env": "EMAIL_PASSWORD",
    "sender_name": "Horizon Daily",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 30,
      "min_score": 100
    },
    "rss": [
      {
        "name": "UN News",
        "url": "https://news.un.org/feed/subscribe/en/news/all/rss.xml",
        "enabled": true,
        "category": "international-organization"
      },
      {
        "name": "UN Geneva Press Releases",
        "url": "https://www.ungeneva.org/en/news-media/press-release/feed",
        "enabled": true,
        "category": "official-diplomacy"
      },
      {
        "name": "Council of the EU Press Releases",
        "url": "https://www.consilium.europa.eu/en/press/press-releases/rss/",
        "enabled": true,
        "category": "official-diplomacy"
      },
      {
        "name": "Council of the EU Foreign Affairs Council",
        "url": "https://www.consilium.europa.eu/en/council-eu/configurations/fac/rss/",
        "enabled": true,
        "category": "official-diplomacy"
      },
      {
        "name": "IMF News",
        "url": "https://www.imf.org/en/News/RSS",
        "enabled": true,
        "category": "macro-finance"
      },
      {
        "name": "World Bank News",
        "url": "https://www.worldbank.org/en/news/all?format=rss",
        "enabled": true,
        "category": "international-organization"
      },
      {
        "name": "ECB Press Releases",
        "url": "https://www.ecb.europa.eu/rss/press.html",
        "enabled": true,
        "category": "macro-finance"
      },
      {
        "name": "Federal Reserve Press Releases",
        "url": "https://www.federalreserve.gov/feeds/press_all.xml",
        "enabled": true,
        "category": "macro-finance"
      },
      {
        "name": "BIS Press Releases",
        "url": "https://www.bis.org/list/press_releases.rss",
        "enabled": true,
        "category": "macro-finance"
      },
      {
        "name": "WTO News",
        "url": "https://www.wto.org/english/news_e/news_e.rss",
        "enabled": true,
        "category": "geo-economics"
      },
      {
        "name": "IEA News",
        "url": "https://www.iea.org/news/rss",
        "enabled": true,
        "category": "energy-commodities"
      },
      {
        "name": "Chatham House",
        "url": "https://www.chathamhouse.org/rss.xml",
        "enabled": true,
        "category": "think-tank"
      },
      {
        "name": "Council on Foreign Relations",
        "url": "https://www.cfr.org/rss.xml",
        "enabled": true,
        "category": "geopolitical-risk"
      },
      {
        "name": "CSIS",
        "url": "https://www.csis.org/rss.xml",
        "enabled": true,
        "category": "geopolitical-risk"
      },
      {
        "name": "Carnegie Endowment for International Peace",
        "url": "https://carnegieendowment.org/rss",
        "enabled": true,
        "category": "think-tank"
      },
      {
        "name": "Atlantic Council",
        "url": "https://www.atlanticcouncil.org/feed/",
        "enabled": true,
        "category": "think-tank"
      },
      {
        "name": "Financial Stability Board News",
        "url": "https://www.fsb.org/feed/",
        "enabled": true,
        "category": "market-risk"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "filtering": {
    "ai_score_threshold": 5.5,
    "time_window_hours": 168
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "overview_position": "first",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": null,
    "request_body": {
      "text": "#{message_title}\n\n#{summary}"
    },
    "headers": ""
  }
}
